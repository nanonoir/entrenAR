# Frontend data source. API is also the runtime default when this variable is unset.
NEXT_PUBLIC_DATA_SOURCE=api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Set the global source to mock only for an offline demo or a contract harness.
# NEXT_PUBLIC_DATA_SOURCE=mock

# Optional domain-specific API URL overrides. They fall back to NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_CATALOG_API_BASE_URL=http://localhost:3001/api/v1
# NEXT_PUBLIC_ACCOUNT_API_BASE_URL=http://localhost:3001/api/v1
# NEXT_PUBLIC_COMMERCE_API_BASE_URL=http://localhost:3001/api/v1
# NEXT_PUBLIC_CHECKOUT_API_BASE_URL=http://localhost:3001/api/v1
# NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:3001/api/v1

# Server-only admin route gate secret. Never prefix this with NEXT_PUBLIC_.
ADMIN_GATE_SIGNING_SECRET=replace-with-a-server-only-gate-secret-at-least-32-chars
