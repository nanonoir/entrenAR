generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum CatalogVisibility {
  VISIBLE
  HIDDEN
}

enum StockMode {
  TRACKED
  INFINITE
  OUT_OF_STOCK
}

enum InventoryOperation {
  ADD
  SUBTRACT
  REPLACE
}

enum PaymentMethodStatus {
  ACTIVE
  INACTIVE
}

enum ShippingProviderStatus {
  NOT_CONFIGURED
  CONFIGURED_INACTIVE
  ACTIVE
}

enum PickupPointStatus {
  NOT_CONFIGURED
  CONFIGURED_INACTIVE
  ACTIVE
}

enum PickupCostType {
  FREE
  FIXED
}

enum PickupCoverageType {
  ALL
  PROVINCES
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum CouponTargetType {
  ALL_STORE
  CATEGORIES
  PRODUCTS
}

enum CouponUsageLimitType {
  UNLIMITED
  LIMITED
}

enum CouponCustomerLimitType {
  UNLIMITED
  LIMITED
  FIRST_PURCHASE
}

enum CouponDateLimitType {
  UNLIMITED
  PERIOD
}

enum CouponMaxDiscountType {
  NONE
  AMOUNT
}

enum CouponStatus {
  ACTIVE
  INACTIVE
}

enum CouponHistoryAction {
  CREATED
  ACTIVATED
  DEACTIVATED
  UPDATED
}

enum ShippingDiscountTargetType {
  ALL_STORE
  CATEGORIES
}

enum ShippingZoneTargetType {
  ALL
  SPECIFIC
}

enum CartStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum CheckoutSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum CheckoutRecoveryStatus {
  PENDING
  SENT
  MANUAL
  RECOVERED
  DISCARDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum OrderDeliveryType {
  SHIPPING
  PICKUP
}

enum OrderShippingStatus {
  TO_PACK
  TO_SHIP
  SHIPPED
  DELIVERED
  PICKUP
  CANCELLED
}

enum OrderHistoryEventType {
  ORDER_CREATED
  PAYMENT_RECEIVED
  PACKAGE_PACKED
  PACKAGE_UNPACKED
  PACKAGE_SHIPPED
  PACKAGE_DELIVERED
  ORDER_CANCELLED
  ORDER_REOPENED
  ORDER_ARCHIVED
  ORDER_UNARCHIVED
  NOTE_ADDED
  ORDER_CONVERTED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum CheckoutIdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  passwordHash         String
  role                 Role                 @default(CUSTOMER)
  firstName            String?
  lastName             String?
  dni                  String?
  gender               String?
  birthDate            DateTime?
  phone                String?
  refreshTokens        RefreshToken[]
  addresses            UserAddress[]
  wishlistItems        WishlistItem[]
  passwordResetTokens  PasswordResetToken[]
  couponHistoryEntries CouponHistory[]      @relation("CouponHistoryActor")
  carts                Cart[]
  checkoutSessions     CheckoutSession[]
  orders               Order[]
  customer             Customer?
  couponRedemptions    CouponRedemption[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model Customer {
  id                   String          @id @default(cuid())
  fullName             String
  email                String?
  phone                String?
  dniOrCuil            String?
  firstInteractionDate DateTime        @default(now())
  notes                String?
  tags                 String[]        @default([])
  isAnonymized         Boolean         @default(false)
  userId               String?         @unique
  user                 User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  address              CustomerAddress?
  orders               Order[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([isAnonymized, createdAt])
}

model CustomerAddress {
  id               String   @id @default(cuid())
  customerId       String   @unique
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street           String
  number           String
  floorOrApartment String?
  postalCode       String
  neighborhood     String?
  city             String
  provinceOrState  String
  country          String   @default("Argentina")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserAddress {
  id         String   @id @default(cuid())
  userId     String
  label      String
  recipient  String
  street     String
  city       String
  province   String
  postalCode String
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Category {
  id                         String                     @id @default(cuid())
  name                       String
  slug                       String                     @unique
  description                String?
  imageUrl                   String?
  googleShoppingCategory     String?
  seoTitle                   String?
  seoDescription             String?
  visibility                 CatalogVisibility          @default(VISIBLE)
  sortOrder                  Int                        @default(0)
  parentId                   String?
  parent                     Category?                  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                   Category[]                 @relation("CategoryHierarchy")
  productCategories          ProductCategory[]
  couponCategories           CouponCategory[]
  shippingDiscountCategories ShippingDiscountCategory[]
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  @@index([parentId])
  @@index([parentId, sortOrder])
  @@index([visibility, sortOrder])
}

model Product {
  id                String             @id @default(cuid())
  legacySourceId    String?            @unique
  slug              String             @unique
  publicSlug        String             @unique
  sku               String             @unique
  name              String
  brand             String?
  description       String?
  shortDescription  String?
  salePrice         Decimal            @db.Decimal(12, 2)
  compareAtPrice    Decimal?           @db.Decimal(12, 2)
  promotionalPrice  Decimal?           @db.Decimal(12, 2)
  imageUrl          String?
  imageTone         String?
  tags              Json               @default("[]")
  highlightSections Json               @default("[]")
  subcategorySlugs  Json               @default("[]")
  variantProperties Json               @default("[]")
  seoTitle          String?
  seoDescription    String?
  shippingRequired  Boolean            @default(true)
  missingLogistics  Boolean            @default(false)
  weightGrams       Int?
  heightCm          Int?
  widthCm           Int?
  lengthCm          Int?
  manualOrder       Int                @default(0)
  visibility        CatalogVisibility  @default(VISIBLE)
  stockMode         StockMode          @default(TRACKED)
  quantity          Int?
  isFeatured        Boolean            @default(false)
  isBestSeller      Boolean            @default(false)
  salesCount        Int                @default(0)
  variants          ProductVariant[]
  categories        ProductCategory[]
  wishlistItems     WishlistItem[]
  inventoryHistory  InventoryHistory[]
  couponProducts    CouponProduct[]
  cartItems         CartItem[]         @relation("CartItemProduct")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([visibility, manualOrder])
  @@index([stockMode])
}

model ProductVariant {
  id               String             @id @default(cuid())
  productId        String
  sku              String             @unique
  name             String
  attributes       Json               @default("{}")
  price            Decimal?           @db.Decimal(12, 2)
  compareAtPrice   Decimal?           @db.Decimal(12, 2)
  stockMode        StockMode          @default(TRACKED)
  quantity         Int?
  isDefault        Boolean            @default(false)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryHistory InventoryHistory[]
  cartItems        CartItem[]         @relation("CartItemVariant")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([productId])
  @@index([productId, isDefault])
  @@index([stockMode])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
}

model InventoryHistory {
  id                String             @id @default(cuid())
  productId         String
  variantId         String?
  operation         InventoryOperation
  delta             Int?
  resultingQuantity Int?
  stockMode         StockMode
  origin            String
  actorId           String?
  reason            String?
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
}

model CatalogSettings {
  id                  String   @id @default("singleton")
  persistOrder        Boolean  @default(true)
  showOutOfStockAtEnd Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PaymentMethodConfig {
  id               String              @id
  name             String
  description      String
  logoSrc          String
  acceptedMethods  Json                @default("[]")
  options          Json                @default("[]")
  status           PaymentMethodStatus @default(INACTIVE)
  selectedOptionId String?
  bankConfig       Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
}

model ShippingProvider {
  id                    String                 @id
  name                  String
  status                ShippingProviderStatus @default(NOT_CONFIGURED)
  enabledModalities     Json                   @default("[]")
  originSenderName      String?
  originCuitCuil        String?
  originPhone           String?
  originEmail           String?
  originStreet          String?
  originNumber          String?
  originCity            String?
  originProvince        String?
  originPostalCode      String?
  originFloor           String?
  originApartment       String?
  originReference       String?
  freeShippingThreshold Decimal?               @db.Decimal(12, 2)
  weightBands           WeightBand[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status])
}

model WeightBand {
  id                 String           @id @default(cuid())
  shippingProviderId String
  minWeightGrams     Int
  maxWeightGrams     Int?
  cost               Decimal          @db.Decimal(12, 2)
  sortOrder          Int              @default(0)
  shippingProvider   ShippingProvider @relation(fields: [shippingProviderId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([shippingProviderId, minWeightGrams])
  @@index([shippingProviderId, sortOrder])
}

model PickupPoint {
  id               String                @id @default(cuid())
  name             String
  status           PickupPointStatus     @default(NOT_CONFIGURED)
  isMain           Boolean               @default(false)
  street           String?
  number           String?
  city             String?
  province         String?
  postalCode       String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  preparationHours Int                   @default(24)
  costType         PickupCostType        @default(FREE)
  fixedCost        Decimal?              @db.Decimal(12, 2)
  coverageType     PickupCoverageType    @default(ALL)
  provinces        Json                  @default("[]")
  schedules        PickupPointSchedule[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status])
}

model PickupPointSchedule {
  id            String      @id @default(cuid())
  pickupPointId String
  dayOfWeek     String
  opensAt       String
  closesAt      String
  sortOrder     Int         @default(0)
  pickupPoint   PickupPoint @relation(fields: [pickupPointId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([pickupPointId, dayOfWeek, sortOrder])
}

model Coupon {
  id                       String                  @id @default(cuid())
  code                     String
  discountType             CouponDiscountType
  discountValue            Decimal?                @db.Decimal(12, 2)
  includeShippingCost      Boolean                 @default(false)
  targetType               CouponTargetType
  canCombineWithPromotions Boolean                 @default(false)
  totalUsageLimitType      CouponUsageLimitType    @default(UNLIMITED)
  totalUsageLimit          Int?
  usageCount               Int                     @default(0)
  customerLimitType        CouponCustomerLimitType @default(UNLIMITED)
  customerUsageLimit       Int?
  dateLimitType            CouponDateLimitType     @default(UNLIMITED)
  startDate                DateTime?
  endDate                  DateTime?
  minimumCartAmount        Decimal                 @default(0) @db.Decimal(12, 2)
  maxDiscountType          CouponMaxDiscountType   @default(NONE)
  maxDiscountAmount        Decimal?                @db.Decimal(12, 2)
  status                   CouponStatus            @default(INACTIVE)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  deletedAt                DateTime?
  categories               CouponCategory[]
  products                 CouponProduct[]
  history                  CouponHistory[]
  redemptions              CouponRedemption[]

  @@index([code])
  @@index([status, deletedAt])
  @@index([deletedAt])
}

model CouponCategory {
  couponId   String
  categoryId String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([couponId, productId])
  @@index([productId])
}

model CouponHistory {
  id        String              @id @default(cuid())
  couponId  String
  action    CouponHistoryAction
  actorId   String?
  actorName String?
  coupon    Coupon              @relation(fields: [couponId], references: [id], onDelete: Cascade)
  actor     User?               @relation("CouponHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime            @default(now())

  @@index([couponId, createdAt])
  @@index([actorId])
}

model ShippingDiscount {
  id                         String                     @id @default(cuid())
  shippingMethodIds          Json                       @default("[]")
  onlyCheapestShippingMethod Boolean                    @default(false)
  targetType                 ShippingDiscountTargetType @default(ALL_STORE)
  canCombineWithPromotions   Boolean                    @default(false)
  zoneTargetType             ShippingZoneTargetType     @default(ALL)
  zoneIds                    Json                       @default("[]")
  minimumCartAmount          Decimal                    @default(0) @db.Decimal(12, 2)
  status                     CouponStatus               @default(INACTIVE)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  deletedAt                  DateTime?
  categories                 ShippingDiscountCategory[]

  @@index([status, deletedAt])
  @@index([deletedAt])
}

model ShippingDiscountCategory {
  shippingDiscountId String
  categoryId         String
  shippingDiscount   ShippingDiscount @relation(fields: [shippingDiscountId], references: [id], onDelete: Cascade)
  category           Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@id([shippingDiscountId, categoryId])
  @@index([categoryId])
}

model Cart {
  id               String            @id @default(cuid())
  userId           String?
  status           CartStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            CartItem[]
  checkoutSessions CheckoutSession[]
  orders           Order[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation("CartItemProduct", fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation("CartItemVariant", fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId, variantId], map: "CartItem_cartId_productId_variantId_key")
  @@index([productId])
  @@index([variantId])
}

model CheckoutSession {
  id                String                 @id @default(cuid())
  tokenHash         String                 @unique
  cartId            String
  userId            String?
  status            CheckoutSessionStatus  @default(ACTIVE)
  recoveryStatus    CheckoutRecoveryStatus @default(PENDING)
  recoveryTokenHash String?                @unique
  recoveryExpiresAt DateTime?
  snapshotData      Json                   @default("{}")
  lastActivityAt    DateTime               @default(now())
  lastEmailSentAt   DateTime?
  abandonedAt       DateTime?
  completedAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  cart              Cart                   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order             Order?
  history           CheckoutSessionHistory[]

  @@index([cartId, status])
  @@index([userId, status])
  @@index([status, abandonedAt])
}

model CheckoutSessionHistory {
  id                String         @id @default(cuid())
  checkoutSessionId String
  eventType         String
  actorId           String?
  actorRole         String?
  notes             String?
  metadata          Json           @default("{}")
  createdAt         DateTime       @default(now())
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)

  @@index([checkoutSessionId, createdAt])
}

model CartRecoverySettings {
  id             String   @id @default("singleton")
  isActive       Boolean  @default(true)
  timing         String   @default("24hs")
  emailSubject   String   @default("Te guardamos tu carrito en EntrenAR")
  emailHtmlBody  String   @default("<p>Hola {{nombre}},</p><p>Vimos que dejaste productos en tu carrito.</p><p><a href=\"{{checkoutUrl}}\">Volver a mi carrito</a></p>")
  emailPlainBody String   @default("Hola {{nombre}},\n\nVimos que dejaste productos en tu carrito.\n\nVolver a mi carrito: {{checkoutUrl}}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id                      String                   @id @default(cuid())
  number                  String                   @unique
  userId                  String?
  customerId              String?
  cartId                  String?
  checkoutSessionId       String?                  @unique
  sourceOrderId            String?
  status                  OrderStatus              @default(PENDING)
  deliveryType            OrderDeliveryType
  shippingStatus           OrderShippingStatus      @default(TO_PACK)
  shippingTrackingCode    String?
  shippingCarrier         String?
  shippingTrackingUrl     String?
  isArchived              Boolean                  @default(false)
  archivedAt              DateTime?
  internalNotes           String?
  cancellationReason      String?
  previousStatus          OrderStatus?
  previousPaymentStatus   PaymentStatus?
  previousShippingStatus  OrderShippingStatus?
  confirmedAt             DateTime?
  packedAt                DateTime?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  cancelledAt             DateTime?
  currency                String                   @default("ARS")
  customerEmail           String
  customerFirstName       String
  customerLastName        String
  customerDni             String?
  customerPhone           String?
  customerSnapshot        Json                     @default("{}")
  shippingAddressSnapshot Json?
  deliverySnapshot        Json                     @default("{}")
  discountSnapshot        Json                     @default("{}")
  subtotal                Decimal                  @db.Decimal(12, 2)
  discountAmount          Decimal                  @default(0) @db.Decimal(12, 2)
  shippingCost            Decimal                  @default(0) @db.Decimal(12, 2)
  total                   Decimal                  @db.Decimal(12, 2)
  couponCode              String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer                Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cart                    Cart?                    @relation(fields: [cartId], references: [id], onDelete: SetNull)
  checkoutSession         CheckoutSession?         @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payment                 OrderPayment?
  idempotencyRecords      CheckoutIdempotencyKey[]
  couponRedemptions       CouponRedemption[]
  history                 OrderHistory[]

  @@index([userId, createdAt])
  @@index([customerId])
  @@index([status, createdAt])
  @@index([cartId])
  @@index([sourceOrderId])
  @@index([shippingStatus, createdAt])
  @@index([isArchived, status, createdAt])
  @@index([shippingTrackingCode])
  @@index([shippingCarrier])
  @@index([customerEmail])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  variantId      String?
  productName    String
  variantName    String?
  sku            String
  attributes     Json     @default("{}")
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  weightGrams    Int?
  lineSubtotal   Decimal  @db.Decimal(12, 2)
  snapshot       Json     @default("{}")
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderPayment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  paymentMethodId       String
  paymentOptionId       String?
  status                PaymentStatus @default(PENDING)
  currency              String        @default("ARS")
  amount                Decimal       @db.Decimal(12, 2)
  paymentMethodSnapshot Json          @default("{}")
  bankTransferSnapshot  Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([paymentMethodId])
}

model OrderHistory {
  id          String                 @id @default(cuid())
  orderId     String
  type        OrderHistoryEventType
  title       String
  description String?
  actorId     String?
  actorRole   Role?
  metadata    Json?
  createdAt   DateTime               @default(now())
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  contactName    String?
  email          String?
  phone          String?
  notes          String?
  status         SupplierStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([status, name])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  orderNumber  String              @unique
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?
  subtotal     Decimal             @db.Decimal(12, 2)
  tax          Decimal             @db.Decimal(12, 2)
  shippingCost Decimal             @db.Decimal(12, 2)
  total        Decimal             @db.Decimal(12, 2)
  expectedDate DateTime?
  receivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items        PurchaseOrderItem[]

  @@index([supplierId, createdAt])
  @@index([status, expectedDate])
  @@index([receivedAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  variantId       String?
  sku             String
  title           String
  quantity        Int
  unitCost        Decimal       @db.Decimal(12, 2)
  totalCost       Decimal       @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([variantId])
}

model CheckoutIdempotencyKey {
  id               String                    @id @default(cuid())
  ownerKey         String
  idempotencyKey   String
  requestHash      String
  status           CheckoutIdempotencyStatus @default(PENDING)
  orderId          String?
  responseSnapshot Json?
  completedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  order            Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([ownerKey, idempotencyKey], map: "CheckoutIdempotencyKey_ownerKey_idempotencyKey_key")
  @@index([orderId])
  @@index([status, createdAt])
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  orderId         String
  userId          String?
  customerKeyHash String?
  couponCode      String
  discountAmount  Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId], map: "CouponRedemption_couponId_orderId_key")
  @@index([couponId, userId])
  @@index([couponId, customerKeyHash])
  @@index([orderId])
}
