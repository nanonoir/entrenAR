# Backend runtime environment.
NODE_ENV=development
PORT=3001

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://entrenar:entrenar-dev-password@127.0.0.1:5432/entrenar?schema=public

# Use unique secrets with at least 32 characters outside local development.
JWT_ACCESS_SECRET=replace-with-a-secure-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-secure-refresh-secret-at-least-32-chars

# Seed administrator credentials (minimum 12 characters password).
ADMIN_EMAIL=admin@entrenar.com
ADMIN_PASSWORD=admin-entrenar-password-123

# Primary frontend URL. Additional preview or local origins may be comma-separated.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# CORS_ORIGIN remains supported for legacy single-origin deployments.
