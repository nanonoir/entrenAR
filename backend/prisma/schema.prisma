generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum CatalogVisibility {
  VISIBLE
  HIDDEN
}

enum StockMode {
  TRACKED
  INFINITE
  OUT_OF_STOCK
}

enum InventoryOperation {
  ADD
  SUBTRACT
  REPLACE
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(CUSTOMER)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id                     String            @id @default(cuid())
  name                   String
  slug                   String            @unique
  description            String?
  imageUrl               String?
  googleShoppingCategory String?
  seoTitle               String?
  seoDescription         String?
  visibility             CatalogVisibility @default(VISIBLE)
  sortOrder              Int               @default(0)
  parentId               String?
  parent                 Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children               Category[]        @relation("CategoryHierarchy")
  productCategories      ProductCategory[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([parentId])
  @@index([parentId, sortOrder])
  @@index([visibility, sortOrder])
}

model Product {
  id                String             @id @default(cuid())
  legacySourceId    String?            @unique
  slug              String             @unique
  publicSlug        String             @unique
  sku               String             @unique
  name              String
  brand             String?
  description       String?
  shortDescription  String?
  salePrice         Decimal            @db.Decimal(12, 2)
  compareAtPrice    Decimal?           @db.Decimal(12, 2)
  promotionalPrice  Decimal?           @db.Decimal(12, 2)
  imageUrl          String?
  imageTone         String?
  tags              Json               @default("[]")
  highlightSections Json               @default("[]")
  subcategorySlugs  Json               @default("[]")
  variantProperties Json               @default("[]")
  seoTitle          String?
  seoDescription    String?
  shippingRequired  Boolean            @default(true)
  missingLogistics  Boolean            @default(false)
  weightGrams       Int?
  heightCm          Int?
  widthCm           Int?
  lengthCm          Int?
  manualOrder       Int                @default(0)
  visibility        CatalogVisibility  @default(VISIBLE)
  stockMode         StockMode          @default(TRACKED)
  quantity          Int?
  isFeatured        Boolean            @default(false)
  isBestSeller      Boolean            @default(false)
  salesCount        Int                @default(0)
  variants          ProductVariant[]
  categories        ProductCategory[]
  inventoryHistory  InventoryHistory[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([visibility, manualOrder])
  @@index([stockMode])
}

model ProductVariant {
  id               String             @id @default(cuid())
  productId        String
  sku              String             @unique
  name             String
  attributes       Json               @default("{}")
  price            Decimal?           @db.Decimal(12, 2)
  compareAtPrice   Decimal?           @db.Decimal(12, 2)
  stockMode        StockMode          @default(TRACKED)
  quantity         Int?
  isDefault        Boolean            @default(false)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryHistory InventoryHistory[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([productId])
  @@index([productId, isDefault])
  @@index([stockMode])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
}

model InventoryHistory {
  id                String             @id @default(cuid())
  productId         String
  variantId         String?
  operation         InventoryOperation
  delta             Int?
  resultingQuantity Int?
  stockMode         StockMode
  origin            String
  actorId           String?
  reason            String?
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
}

model CatalogSettings {
  id                  String   @id @default("singleton")
  persistOrder        Boolean  @default(true)
  showOutOfStockAtEnd Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
