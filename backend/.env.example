# Backend runtime environment.
NODE_ENV=development
PORT=3001

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://entrenar:entrenar-dev-password@127.0.0.1:5432/entrenar?schema=public

# Use unique secrets with at least 32 characters outside local development.
JWT_ACCESS_SECRET=replace-with-a-secure-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-secure-refresh-secret-at-least-32-chars
ADMIN_GATE_SIGNING_SECRET=replace-with-a-server-only-gate-secret-at-least-32-chars
JWT_ADMIN_ACCESS_TTL_SECONDS=900
JWT_ADMIN_REFRESH_TTL_SECONDS=1800
REFRESH_CONCURRENCY_TOLERANCE_SECONDS=5

# Public showcase administrator fixture used by the idempotent seed and frontend E2E defaults.
# Override ADMIN_EMAIL/ADMIN_PASSWORD or E2E_ADMIN_EMAIL/E2E_ADMIN_PASSWORD only for another environment.
ADMIN_EMAIL=prueba@entrenar.com
ADMIN_PASSWORD=pruebaentrenar

# Primary frontend URL. Additional preview or local origins may be comma-separated.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# CORS_ORIGIN remains supported for legacy single-origin deployments.
